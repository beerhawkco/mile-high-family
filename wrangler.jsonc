{
  "name": "mile-high-family",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-25",
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["15 13 * * *"]
  }
}
