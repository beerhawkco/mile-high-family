---
import MountainMark from './MountainMark.astro';
import Squiggle from './Squiggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import WaveEdge from './WaveEdge.astro';

interface Props {
  kicker?: string;
  heading?: string;
  lede?: string;
  showNav?: boolean;
}

const {
  kicker = 'Private garage',
  heading = 'Market pulse',
  lede = 'Sold prints, current asks, and days listed before sale — 250 miles of Denver.',
  showNav = true,
} = Astro.props;
---

<a class="g-skip" href="#garage-main">Skip to garage</a>
<header class="g-hero">
  <div class="blob blob-sun"></div>
  <div class="blob blob-2 blob-sky"></div>
  <div class="g-sticky">
    <div class="g-hero-inner">
      <div class="g-top">
        <a class="g-wordmark" href="/garage/">
          <MountainMark class="size-10" />
          <span>
            <strong>Garage desk</strong>
            <em>Mile High Family</em>
          </span>
        </a>
        <div class="g-tools">
          <ThemeToggle />
        </div>
      </div>
      {
        showNav && (
          <nav class="g-nav" aria-label="Garage">
            <a data-nav="home" href="/garage/">
              Summary
            </a>
            <a data-nav="cars" href="/garage/cars/">
              Cars
            </a>
            <a data-nav="rvs" href="/garage/rvs/">
              RVs
            </a>
            <a data-nav="desk" href="/garage/desk/">
              Desk
            </a>
            <button type="button" id="logout-btn">Sign out</button>
          </nav>
        )
      }
    </div>
  </div>
  <div class="g-hero-inner" style="padding-bottom: 0.4rem">
    <p class="g-kicker -rotate-1" id="g-kicker">{kicker}</p>
    <h1 class="g-title -rotate-1" id="g-title">{heading}</h1>
    <Squiggle class="mt-3 text-sun -rotate-2" />
    <p class="g-lede rotate-1" id="g-lede">{lede}</p>
    <p class="g-status" id="status" data-kind="ok">Locked.</p>
  </div>
  <WaveEdge fill="var(--bg)" variant="a" />
</header>
