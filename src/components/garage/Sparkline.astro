---
import { sparkPath } from '../../lib/garage/charts';

interface Props {
  values: number[];
  label: string;
}

const { values, label } = Astro.props;
const path = sparkPath(values);
---

<svg class="h-16 w-full" viewBox="0 0 220 64" role="img" aria-label={label}>
  <path d={path} fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
