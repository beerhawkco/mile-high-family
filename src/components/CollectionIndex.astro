---
import ContentCard from './ContentCard.astro';
import WaveEdge from './WaveEdge.astro';
import { COLLECTION_META, sortByDate, type CollectionKey } from '../lib/content';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  collection: CollectionKey;
}

const { collection } = Astro.props;
const meta = COLLECTION_META[collection];
const posts = sortByDate(await getCollection(collection));
---

<BaseLayout title={meta.label} description={meta.blurb}>
  <section class="relative overflow-hidden bg-bg2">
    <div class="blob -left-16 top-0 size-40 bg-sun/40"></div>
    <div class="blob blob-2 right-0 top-8 size-48 bg-navy/10"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <p class="eyebrow -rotate-1">{meta.eyebrow}</p>
      <h1 class="mt-2 -rotate-1 font-display text-5xl font-extrabold text-ink">{meta.label}</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">{meta.blurb}</p>
    </div>
    <WaveEdge fill="var(--bg)" variant="b" />
  </section>
  <section class="mx-auto flex max-w-6xl flex-wrap justify-center gap-6 px-4 py-8 sm:px-6">
    {posts.map((post, index) => (
      <div class:list={[index === 0 ? 'w-full' : 'w-[min(100%,22rem)] flex-1']}>
        <ContentCard post={post} collection={collection} featured={index === 0} />
      </div>
    ))}
  </section>
</BaseLayout>
