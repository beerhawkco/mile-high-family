---
import '../styles/global.css';

interface Props {
  title: string;
  view: 'home' | 'cars' | 'rvs' | 'vehicle';
  slug?: string;
}

const { title, view, slug = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700;800&family=Outfit:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-bg font-body text-ink" data-garage-view={view} data-garage-slug={slug}>
    <main class="mx-auto max-w-6xl px-5 py-8">
      <p class="eyebrow">Private garage</p>
      <p id="status" class="mt-2 font-extrabold" data-kind="ok">Locked.</p>

      <section id="login-panel" class="mt-6 max-w-lg squash bg-surface p-6 shadow-sm">
        <h1 class="font-display text-3xl font-extrabold">Sign in</h1>
        <p class="mt-2 text-muted">Username and password. This whole garage stays off the public site.</p>
        <form id="login-form" class="mt-4">
          <label class="sr-only">Leave blank<input id="website" name="website" tabindex="-1" autocomplete="off" /></label>
          <label class="mt-3 block font-extrabold">Username<input id="username" class="mt-1 w-full rounded-2xl border border-line bg-bg px-3 py-3" type="text" autocomplete="username" required /></label>
          <label class="mt-3 block font-extrabold">Password<input id="password" class="mt-1 w-full rounded-2xl border border-line bg-bg px-3 py-3" type="password" autocomplete="current-password" required /></label>
          <button type="submit" class="btn-curve mt-5 bg-sun px-6 py-3 font-display font-extrabold text-navy">Sign in</button>
        </form>
      </section>

      <section id="app-panel" class="hidden">
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <a class="btn-curve bg-chip px-4 py-2 font-extrabold no-underline" href="/garage/">Summary</a>
          <a class="btn-curve bg-chip px-4 py-2 font-extrabold no-underline" href="/garage/cars/">Cars</a>
          <a class="btn-curve bg-chip px-4 py-2 font-extrabold no-underline" href="/garage/rvs/">RVs</a>
          <a class="btn-curve bg-chip px-4 py-2 font-extrabold no-underline" href="/garage/desk/">Desk</a>
          <button type="button" id="logout-btn" class="btn-curve bg-navy px-4 py-2 font-extrabold text-cream">Sign out</button>
        </div>
        <div id="garage-app" class="mt-8"></div>
      </section>
    </main>
    <script>
      import { bootGarage } from '../lib/garage/app';
      bootGarage();
    </script>
  </body>
</html>

<style>
  #status[data-kind='err'] { color: #8b2e2e; }
  #status[data-kind='busy'] { color: #e87820; }
  .hidden { display: none !important; }
</style>
