---
import GarageChrome from '../components/GarageChrome.astro';
import '../styles/global.css';
import '../styles/garage.css';

interface Props {
  title: string;
  view: 'home' | 'cars' | 'rvs' | 'vehicle';
  slug?: string;
  section?: 'cars' | 'rvs';
}

const { title, view, slug = '', section = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700;800&family=Outfit:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('mhf-theme');
          var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body
    class="g-page font-body text-ink"
    data-garage-view={view}
    data-garage-slug={slug}
    data-garage-section={section}
  >
    <GarageChrome
      kicker="Private garage"
      heading="Market pulse"
      lede="Sold prints, current asks, and days listed before sale — 250 miles of Denver."
    />
    <main id="garage-main" class="g-wrap">
      <section id="login-panel" class="g-card g-gate tilt-l">
        <p class="g-badge">Locked</p>
        <h2 class="mt-2 font-display text-3xl font-extrabold">Sign in</h2>
        <p class="help mt-2">Username and password. This whole garage stays off the public site.</p>
        <form id="login-form" class="g-form mt-3">
          <label class="hp">Leave blank<input id="website" name="website" tabindex="-1" autocomplete="off" /></label>
          <label>
            Username
            <input id="username" type="text" autocomplete="username" required />
          </label>
          <label>
            Password
            <input id="password" type="password" autocomplete="current-password" required />
          </label>
          <button type="submit" class="g-btn mt-2">Sign in</button>
        </form>
      </section>

      <section id="app-panel" class="hidden">
        <div id="garage-app"></div>
      </section>
    </main>
    <p class="g-foot">Private notebook · not linked from the public site · Denver 250-mile ring</p>
    <script>
      import { bootGarage } from '../lib/garage/app';
      bootGarage();
    </script>
  </body>
</html>
