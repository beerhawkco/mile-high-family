---
import GarageChrome from '../../components/GarageChrome.astro';
import '../../styles/global.css';
import '../../styles/garage.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <title>Garage desk</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Fraunces:opsz,wght@144,600;144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('mhf-theme');
          var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="g-page g-locked desk" data-garage-view="desk">
    <GarageChrome
      line1="Garage"
      line2="Desk"
      accent="Market pulse"
      meta="80202 · 250 mi"
      lede="Edit units, comps, and the Denver tape. Username and password only."
    />
    <main id="garage-main" class="g-wrap">
      <section id="login-panel" class="g-card g-gate">
        <p class="g-meta-pill">Locked</p>
        <h2>Sign in</h2>
        <p class="help">Normal admin login. You will never be asked for a personal access token here.</p>
        <form id="login-form" class="g-form">
          <label class="hp">Leave blank<input id="website" name="website" tabindex="-1" autocomplete="off" /></label>
          <label>Username<input id="username" type="text" autocomplete="username" required /></label>
          <label>Password<input id="password" type="password" autocomplete="current-password" required /></label>
          <button type="submit" class="g-btn">Sign in</button>
        </form>
      </section>

      <section id="app-panel" class="hidden">
        <p id="signed-in" class="help"></p>

        <div class="g-card" style="margin-top: 1rem">
          <div class="row">
            <h2>Pulse controls</h2>
            <p class="help">Fetch, review, then save</p>
          </div>
          <label>Vehicle
            <select id="vehicle"></select>
          </label>
          <div class="toolbar">
            <button type="button" id="pulse-btn" class="btn ghost">Fetch Denver 250-mile market</button>
            <button type="button" id="save-btn" class="btn">Save all changes</button>
          </div>
        </div>

        <div class="g-card" style="margin-top: 1rem">
          <h2>This unit</h2>
          <label>Intent
            <select id="vehicle-intent">
              <option value="sell">Selling ours</option>
              <option value="buy">Watching to buy</option>
            </select>
          </label>
          <label>Listing status
            <select id="owned-status">
              <option value="preparing">Not listed yet</option>
              <option value="listed">Listed</option>
              <option value="sold">Sold</option>
            </select>
          </label>
          <div class="grid">
            <label>Our ask<input id="owned-ask" type="number" step="100" /></label>
            <label>Target<input id="owned-target" type="number" step="100" /></label>
            <label>Listed on<input id="owned-listed" type="date" /></label>
            <label>Our miles<input id="owned-miles" type="number" /></label>
            <label>Our hours<input id="owned-hours" type="number" /></label>
            <label>Sold price<input id="owned-sold" type="number" step="100" /></label>
            <label>Sold on<input id="owned-sold-on" type="date" /></label>
          </div>
          <label>Condition<input id="owned-condition" type="text" /></label>
          <label>Listing URL<input id="owned-url" type="url" /></label>
          <label>Our notes<textarea id="owned-notes" rows="3"></textarea></label>
          <label>Summary<textarea id="vehicle-summary" rows="3"></textarea></label>
          <label>Private / desk notes<textarea id="vehicle-notes" rows="3"></textarea></label>
        </div>

        <div class="g-card" style="margin-top: 1rem">
          <h2>Market snapshot</h2>
          <div class="grid">
            <label>Date<input id="snap-date" type="date" /></label>
            <label>Median ask<input id="snap-median" type="number" step="100" /></label>
            <label>Low ask<input id="snap-low" type="number" step="100" /></label>
            <label>High ask<input id="snap-high" type="number" step="100" /></label>
            <label>Sold median<input id="snap-sold" type="number" step="100" /></label>
            <label>Sold count<input id="snap-sold-count" type="number" step="1" /></label>
            <label>Current asking listings<input id="snap-count" type="number" step="1" /></label>
            <label>Days currently listed (median)<input id="snap-dom" type="number" step="1" /></label>
            <label>Days listed before sale (median)<input id="snap-days-to-sale" type="number" step="1" /></label>
            <label>Sentiment score (−100 to 100)<input id="snap-score" type="number" step="1" /></label>
            <label>Sentiment
              <select id="snap-sentiment">
                <option value="hot">Hot</option>
                <option value="warm">Warm</option>
                <option value="cool">Cool</option>
                <option value="cold">Cold</option>
              </select>
            </label>
            <label>Trend
              <select id="snap-trend">
                <option value="up">Up</option>
                <option value="flat">Flat</option>
                <option value="down">Down</option>
              </select>
            </label>
          </div>
          <label>Headline<input id="snap-headline" type="text" /></label>
          <label>Brief<textarea id="snap-brief" rows="4"></textarea></label>
          <label class="check"><input id="snap-review" type="checkbox" /> Needs review</label>
        </div>

        <div class="g-card" style="margin-top: 1rem">
          <div class="row">
            <h2>Track an ad</h2>
            <p class="help">Screenshot or listing photo of an ad you want followed</p>
          </div>
          <div id="ad-drop" class="g-drop">
            <input id="ad-file" type="file" accept="image/jpeg,image/png,image/webp,image/*" />
            <img id="ad-preview" alt="" class="g-preview hidden" />
            <p id="ad-drop-hint">Drop, paste, or choose a photo of the ad</p>
          </div>
          <div class="grid">
            <label>Title<input id="ad-title" type="text" placeholder="2019 Thor 28A · Castle Rock" /></label>
            <label>Ask<input id="ad-price" type="number" step="100" /></label>
            <label>Ad URL<input id="ad-url" type="url" placeholder="https://…" /></label>
            <label>Source<input id="ad-source" type="text" placeholder="FB Marketplace, Craigslist…" /></label>
          </div>
          <label>Notes<textarea id="ad-notes" rows="2" placeholder="What you want remembered about this ad"></textarea></label>
          <div class="toolbar">
            <button type="button" id="track-ad-btn" class="btn">Track this ad</button>
          </div>
        </div>

        <div class="g-card" style="margin-top: 1rem">
          <div class="row">
            <h2>Comps</h2>
            <button type="button" id="add-comp" class="btn ghost">Add blank comp</button>
          </div>
          <div id="comp-list" class="list"></div>
        </div>

        <div class="g-card" style="margin-top: 1rem">
          <div class="row">
            <h2>Sentiment notes</h2>
            <button type="button" id="add-note" class="btn ghost">Add note</button>
          </div>
          <div id="note-list" class="list"></div>
        </div>
      </section>
    </main>
    <p class="g-foot">Private notebook · username and password only</p>
    <script>
      import { boot } from '../../lib/garage/desk';
      boot();
    </script>
  </body>
</html>
